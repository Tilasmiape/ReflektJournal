
@inject ReflektJournal.Services.Interfaces.IAuthService Auth
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        await EnforceAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await EnforceAsync();
    }

    private async Task EnforceAsync()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var registered = await Auth.IsRegisteredAsync();

        if (!registered)
        {
            if (path != "/signup")
                Nav.NavigateTo("/signup", replace: true);
            return;
        }

        if (!Auth.IsUnlocked)
        {
            if (path is not ("/login" or "/signup"))
                Nav.NavigateTo("/login", replace: true);
            return;
        }

        // Unlocked
        if (path is "/login" or "/signup" or "")
            Nav.NavigateTo("/today", replace: true);
    }
}
