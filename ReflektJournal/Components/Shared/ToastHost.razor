
@using ReflektJournal.Models
@using ReflektJournal.Services.Interfaces
@inject IToastService Toasts

@if (_active is not null)
{
    <div class="toast-wrap">
        <div class="toast @CssFor(_active.Type)">
            @_active.Text
        </div>
    </div>
}

@code {
    private ToastMessage? _active;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        Toasts.OnShow += Show;
    }

    private void Show(ToastMessage msg)
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        _active = msg;
        InvokeAsync(StateHasChanged);

        _ = HideLaterAsync(msg.DurationMs, _cts.Token);
    }

    private async Task HideLaterAsync(int ms, CancellationToken ct)
    {
        try
        {
            await Task.Delay(ms, ct);
            _active = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private static string CssFor(ToastType t) => t switch
    {
        ToastType.Success => "toast-success",
        ToastType.Error => "toast-error",
        _ => "toast-info"
    };

    public void Dispose()
    {
        Toasts.OnShow -= Show;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

<style>
    .toast-wrap {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 9999;
    }

    .toast {
        min-width: 320px;
        max-width: 520px;
        padding: 14px 16px;
        border-radius: 14px;
        box-shadow: 0 16px 40px rgba(0,0,0,.25);
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.15);
    }

    .toast-success { border-color: rgba(0, 255, 160, .35); }
    .toast-error   { border-color: rgba(255, 80, 80, .45); }
    .toast-info    { border-color: rgba(120, 170, 255, .45); }
</style>
