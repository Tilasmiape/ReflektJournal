@page "/today"

@using ReflektJournal.Models
@using ReflektJournal.Services.Interfaces
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Markdig

@inject IAuthService Auth
@inject IJournalService Journal
@inject IMoodService MoodService
@inject ITagService TagService
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<h1 class="page-title">Reflections</h1>

@if (!_ready)
{
    <p class="muted">Loading...</p>
}
else if (_entryExists && !_editMode)
{
    <!-- ✅ Entry already exists panel -->
    <div class="exists-card">
        <div class="exists-icon">!</div>
        <div class="exists-title">Entry Already Exists</div>
        <div class="exists-sub">
            You've already written for <b>@_displayDate</b>. You can edit today's entry instead.
        </div>

        <div class="exists-actions">
            <button class="btn ghost" @onclick="GoBack" type="button">Go Back</button>
            <button class="btn primary" @onclick="GoToEdit" type="button">Edit Today's Entry</button>
        </div>
    </div>
}
else
{
    <!-- ✅ Editor -->
    <div class="card">
        <div class="date-row">@_displayDate</div>

        <div class="field">
            <label>Journal Title <span class="req">*</span></label>
            <input class="input" @bind="_title" />
        </div>

        <div class="field">
            <label>How are you feeling? <span class="req">*</span></label>

            <div class="primary-row">
                @foreach (var p in _primaryMoods)
                {
                    var active = _primaryMoodId == p.Id;
                    <button type="button"
                            class="primaryMood @(active ? "active" : "")"
                            @onclick="@(() => SelectPrimary(p.Id))">
                        <span class="emoji">@PrimaryEmoji(p.GroupKey)</span>
                        <span class="label">@p.Name</span>
                    </button>
                }
            </div>
        </div>

        <div class="field">
            <label>Specific emotions (up to 2) <span class="req">*</span></label>

            @if (_primaryMoodId is null)
            {
                <div class="hint">Choose a primary mood to see emotions.</div>
            }
            else
            {
                <div class="chip-row">
                    @foreach (var s in _secondaryForSelectedPrimary)
                    {
                        var on = _secondaryMoodIds.Contains(s.Id);
                        <button type="button"
                                class="chip @(on ? "chip-on" : "chip-off")"
                                @onclick="@(() => ToggleSecondary(s.Id))">
                            @s.Name
                        </button>
                    }
                </div>

                <div class="hint">Selected: @_secondaryMoodIds.Count / 2</div>
            }
        </div>

        <div class="field">
            <label>Tags</label>

            <div class="chip-row">
                @foreach (var t in _allTags)
                {
                    var on = _selectedTagIds.Contains(t.Id);
                    <button type="button"
                            class="chip @(on ? "chip-on" : "chip-off")"
                            @onclick="@(() => ToggleTag(t.Id))">
                        @t.Name
                    </button>
                }
            </div>

            <div class="tag-add">
                <input class="input"
                       placeholder="Add custom tag and press Enter"
                       @bind="_customTag"
                       @onkeydown="OnCustomTagKeyDown" />
                <button type="button" class="btn ghost" @onclick="AddCustomTag">Add</button>
            </div>

            @if (_customTags.Count > 0)
            {
                <div class="custom-tags">
                    @foreach (var t in _customTags)
                    {
                        <span class="custom-chip">
                            @t
                            <button type="button" class="x" @onclick="@(() => RemoveCustomTag(t))">×</button>
                        </span>
                    }
                </div>
            }
        </div>

        <div class="field">
            <div class="entry-header">
                <label>Entry (Markdown supported)</label>

                <button type="button" class="btn ghost sm" @onclick="TogglePreview">
                    @(_showPreview ? "Hide Preview" : "Show Preview")
                </button>
            </div>

            <div class="md-toolbar">
                <button type="button" class="tool" title="Bold" @onclick="BoldAsync"><b>B</b></button>
                <button type="button" class="tool" title="Italic" @onclick="ItalicAsync"><i>I</i></button>
                <button type="button" class="tool" title="Heading" @onclick="HeadingAsync">H</button>
                <button type="button" class="tool" title="Bulleted list" @onclick="BulletAsync">•</button>
                <button type="button" class="tool" title="Numbered list" @onclick="NumberedAsync">1.</button>
                <button type="button" class="tool" title="Link" @onclick="LinkAsync">🔗</button>
            </div>

            <textarea class="textarea"
                      @ref="_entryArea"
                      rows="10"
                      @bind="_content"
                      @bind:event="oninput"
                      @bind:after="OnContentAfterChanged"
                      placeholder="Write your thoughts..."></textarea>

            @if (_showPreview)
            {
                <div class="md-preview">
                    @((MarkupString)_previewHtml)
                </div>
            }
        </div>

        <div class="row">
            <button class="btn primary" @onclick="SaveAsync" disabled="@_saving" type="button">
                @(_saving ? "Saving..." : "Save Entry")
            </button>

            @if (_entryExists && _editMode)
            {
                <button class="btn ghost" @onclick="CancelEdit" type="button">Cancel</button>
            }
        </div>
    </div>
}

@code {
    private bool _ready;
    private bool _saving;

    private int _userId;
    private int _entryId;

    private bool _entryExists;
    private bool _editMode;

    private string _dateIso = "";
    private string _displayDate = "";

    private string _title = "";
    private string _content = "";

    private List<Mood> _allMoods = new();
    private List<Mood> _primaryMoods = new();
    private List<Mood> _secondaryForSelectedPrimary = new();

    private int? _primaryMoodId;
    private readonly HashSet<int> _secondaryMoodIds = new();

    private List<JournalTag> _allTags = new();
    private readonly HashSet<int> _selectedTagIds = new();

    private string _customTag = "";
    private readonly HashSet<string> _customTags = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, SupplyParameterFromQuery(Name = "date")]
    public string? Date { get; set; }


    [Parameter, SupplyParameterFromQuery(Name = "edit")]
    public string? Edit { get; set; }

    // Markdown
    private ElementReference _entryArea;
    private bool _showPreview = true;
    private string _previewHtml = "";

    private static readonly MarkdownPipeline _mdPipeline =
        new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("/signup", replace: true);
            return;
        }

        _userId = user.Id;

        _allMoods = (await MoodService.ListAsync()).ToList();
        _primaryMoods = _allMoods.Where(m => m.IsPrimary).ToList();

        _allTags = (await TagService.ListAsync()).ToList();

        _ready = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready) return;

        var target = ParseDateOrToday(Date);
        _dateIso = target.ToString("yyyy-MM-dd");
        _displayDate = target.ToString("dddd, MMMM d, yyyy");

        await LoadStateForDateAsync();
        RefreshPreview();
        StateHasChanged();
    }

    private static DateTime ParseDateOrToday(string? iso)
        => DateTime.TryParse((iso ?? "").Trim(), out var dt) ? dt.Date : DateTime.Now.Date;

    private bool IsEditRequested()
        => string.Equals(Edit, "1", StringComparison.OrdinalIgnoreCase)
           || string.Equals(Edit, "true", StringComparison.OrdinalIgnoreCase);

    private async Task LoadStateForDateAsync()
    {
        var existing = await Journal.GetByDateAsync(_dateIso);

        if (existing is null)
        {
            // ✅ no entry: allow writing
            _entryExists = false;
            _editMode = true;
            _entryId = 0;
            ResetForm();

            // default primary mood
            var neutral = _primaryMoods.FirstOrDefault(m => m.GroupKey == "Neutral" || m.Name == "Neutral");
            if (neutral is not null) SelectPrimary(neutral.Id);
            return;
        }

        // ✅ entry exists
        _entryExists = true;
        _entryId = existing.Id;

        if (IsEditRequested())
        {
            // ✅ load into editor
            _editMode = true;

            _title = existing.Title ?? "";
            _content = existing.ContentMarkdown ?? "";

            var moodState = await MoodService.GetEntryMoodsAsync(existing.Id);
            _primaryMoodId = moodState.PrimaryMoodId;

            _secondaryMoodIds.Clear();
            foreach (var id in moodState.SecondaryMoodIds)
                _secondaryMoodIds.Add(id);

            if (_primaryMoodId is not null)
                SelectPrimary(_primaryMoodId.Value);

            _selectedTagIds.Clear();
            _customTags.Clear();

            var existingTagNames = await TagService.ListTagsForEntryAsync(existing.Id);
            var known = _allTags.ToDictionary(t => t.Name, t => t.Id, StringComparer.OrdinalIgnoreCase);

            foreach (var name in existingTagNames)
            {
                if (known.TryGetValue(name, out var id))
                    _selectedTagIds.Add(id);
                else
                    _customTags.Add(name);
            }
        }
        else
        {
            // ✅ show exists-panel instead of editor
            _editMode = false;
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _title = "";
        _content = "";
        _primaryMoodId = null;
        _secondaryMoodIds.Clear();
        _selectedTagIds.Clear();
        _customTag = "";
        _customTags.Clear();
        _secondaryForSelectedPrimary = new List<Mood>();
        RefreshPreview();
    }

    private void GoBack() => Nav.NavigateTo("/entries", replace: true);

    private void GoToEdit()
        => Nav.NavigateTo($"/today?date={_dateIso}&edit=1", replace: true);

    private void CancelEdit()
        => Nav.NavigateTo($"/today?date={_dateIso}", replace: true);

    private void SelectPrimary(int primaryId)
    {
        _primaryMoodId = primaryId;
        _secondaryMoodIds.Clear();

        var primary = _allMoods.First(m => m.Id == primaryId);
        _secondaryForSelectedPrimary = _allMoods
            .Where(m => !m.IsPrimary && m.GroupKey == primary.GroupKey)
            .OrderBy(m => m.Name)
            .ToList();
    }

    private void ToggleSecondary(int moodId)
    {
        if (_secondaryMoodIds.Contains(moodId))
        {
            _secondaryMoodIds.Remove(moodId);
            return;
        }

        if (_secondaryMoodIds.Count >= 2)
        {
            Toast.Error("You can select up to 2 secondary emotions.");
            return;
        }

        _secondaryMoodIds.Add(moodId);
    }

    private void ToggleTag(int tagId)
    {
        if (_selectedTagIds.Contains(tagId))
            _selectedTagIds.Remove(tagId);
        else
            _selectedTagIds.Add(tagId);
    }

    private Task OnCustomTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddCustomTag();

        return Task.CompletedTask;
    }

    private void AddCustomTag()
    {
        var name = (_customTag ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;

        _customTags.Add(name);
        _customTag = "";
    }

    private void RemoveCustomTag(string name) => _customTags.Remove(name);

    private void TogglePreview()
    {
        _showPreview = !_showPreview;
        if (_showPreview) RefreshPreview();
    }

    private void RefreshPreview()
        => _previewHtml = Markdown.ToHtml(_content ?? "", _mdPipeline);

    private Task OnContentAfterChanged()
    {
        if (_showPreview) RefreshPreview();
        return Task.CompletedTask;
    }

    // ✅ toolbar commands (no quote/onclick bugs)
    private async Task BoldAsync() => await JS.InvokeVoidAsync("mdEditor.wrap", _entryArea, "**", "**");
    private async Task ItalicAsync() => await JS.InvokeVoidAsync("mdEditor.wrap", _entryArea, "*", "*");
    private async Task HeadingAsync() => await JS.InvokeVoidAsync("mdEditor.prefixLines", _entryArea, "# ");
    private async Task BulletAsync() => await JS.InvokeVoidAsync("mdEditor.prefixLines", _entryArea, "- ");
    private async Task NumberedAsync() => await JS.InvokeVoidAsync("mdEditor.prefixLines", _entryArea, "1. ");
    private async Task LinkAsync() => await JS.InvokeVoidAsync("mdEditor.insertAtCursor", _entryArea, "[text](https://example.com)");

    private async Task SaveAsync()
    {
        if (_saving) return;
        _saving = true;

        try
        {
            if (!_editMode && _entryExists)
            {
                Toast.Error("Entry already exists for this day. Click Edit.");
                return;
            }

            if (string.IsNullOrWhiteSpace(_title))
            {
                Toast.Error("Title is required!");
                return;
            }

            if (_primaryMoodId is null)
            {
                Toast.Error("Please select a primary mood.");
                return;
            }

            if (_secondaryMoodIds.Count < 1)
            {
                Toast.Error("Please select at least one secondary emotion.");
                return;
            }

            // ✅ if entry exists, always update that same record
            var existing = await Journal.GetByDateAsync(_dateIso);
            var idToUse = existing?.Id ?? _entryId;

            var entry = new JournalEntry
            {
                Id = idToUse,
                UserId = _userId,
                DateIso = _dateIso,
                Title = _title.Trim(),
                ContentMarkdown = _content ?? "",
                WordCount = CountWords(_content ?? "")
            };

            var savedId = await Journal.UpsertAsync(entry);
            _entryId = savedId;

            await MoodService.SetEntryMoodsAsync(savedId, _primaryMoodId.Value, _secondaryMoodIds.ToList());

            var selectedTagNames = _allTags
                .Where(t => _selectedTagIds.Contains(t.Id))
                .Select(t => t.Name)
                .Concat(_customTags)
                .Select(t => (t ?? "").Trim())
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            await TagService.SetTagsForEntryAsync(savedId, selectedTagNames);

            Toast.Success("Journal entry saved successfully!");
            Nav.NavigateTo("/entries", replace: true); // ✅ go back to timeline so you SEE the update
        }
        catch
        {
            Toast.Error("Failed to save entry.");
        }
        finally
        {
            _saving = false;
        }
    }

    private static int CountWords(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 0;
        return text.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    }

    private static string PrimaryEmoji(string groupKey) => groupKey switch
    {
        "Positive" => "😊",
        "Neutral" => "😐",
        "Negative" => "😔",
        _ => "🙂"
    };
}

<style>
    .page-title {
        font-size: 54px;
        font-weight: 900;
        margin: 10px 0 10px;
    }

    .muted {
        opacity: .75
    }

    .req {
        color: #ffb86b
    }

    .card {
        max-width: 980px;
        padding: 18px;
        border-radius: 18px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
    }

    .date-row {
        opacity: .75;
        margin-bottom: 10px
    }

    .field {
        margin-top: 14px
    }

        .field label {
            display: block;
            margin-bottom: 8px;
            opacity: .9
        }

    .input, .textarea {
        width: 100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(0,0,0,.18);
        color: inherit;
        outline: none;
    }

    .primary-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap
    }

    .primaryMood {
        min-width: 220px;
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(0,0,0,.14);
        cursor: pointer;
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: center;
    }

        .primaryMood.active {
            border: 2px solid #ffb86b;
            box-shadow: 0 0 0 4px rgba(255,184,107,.16);
        }

    .emoji {
        font-size: 18px
    }

    .label {
        font-weight: 700
    }

    .chip-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap
    }

    .chip {
        padding: 10px 14px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.12);
        cursor: pointer;
    }

    .chip-on {
        border: 2px solid #ffb86b
    }

    .chip-off {
        opacity: .85
    }

    .hint {
        opacity: .7;
        margin-top: 8px
    }

    .tag-add {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 10px
    }

    .custom-tags {
        margin-top: 10px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap
    }

    .custom-chip {
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.12);
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .custom-chip .x {
            background: transparent;
            border: 0;
            cursor: pointer;
            font-size: 18px;
            color: inherit
        }

    .row {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 14px;
        flex-wrap: wrap
    }

    .btn {
        border: 0;
        border-radius: 12px;
        padding: 10px 14px;
        cursor: pointer;
        font-weight: 800;
    }

        .btn.primary {
            background: rgba(255,184,107,.22);
            border: 1px solid rgba(255,184,107,.45)
        }

        .btn.ghost {
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.14)
        }

        .btn.sm {
            padding: 6px 10px;
            border-radius: 10px;
            font-weight: 800
        }

    .entry-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px
    }

    .md-toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 8px
    }

    .tool {
        border: 1px solid rgba(255,255,255,.14);
        background: rgba(0,0,0,.14);
        border-radius: 10px;
        padding: 6px 10px;
        cursor: pointer;
    }

    .md-preview {
        margin-top: 12px;
        padding: 14px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(0,0,0,.12);
    }

        .md-preview h1, .md-preview h2, .md-preview h3 {
            margin-top: 14px
        }

        .md-preview a {
            text-decoration: underline
        }

        .md-preview code {
            padding: 2px 6px;
            border-radius: 8px;
            background: rgba(255,255,255,.08)
        }

    .exists-card {
        max-width: 980px;
        border-radius: 18px;
        padding: 26px 18px;
        background: rgba(255,184,107,.10);
        border: 1px solid rgba(255,184,107,.35);
        text-align: center;
    }

    .exists-icon {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,184,107,.45);
        background: rgba(255,184,107,.18);
        font-weight: 900;
        margin-bottom: 12px;
    }

    .exists-title {
        font-size: 30px;
        font-weight: 900;
        margin-bottom: 8px;
        color: #ffcc9a
    }

    .exists-sub {
        opacity: .9;
        margin-bottom: 16px
    }

    .exists-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap
    }
</style>
