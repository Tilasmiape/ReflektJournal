
@page "/entry/{Id:int}"

@using ReflektJournal.Models
@using ReflektJournal.Services.Interfaces
@using Markdig

@inject IAuthService Auth
@inject IJournalService Journal
@inject IToastService Toast
@inject NavigationManager Nav

<h1 class="entry-title">Entry</h1>

@if (!_ready)
{
    <div class="center">Loading...</div>
}
else if (_entry is null)
{
    <div class="panel">
        <div class="panel-title">Entry not found</div>
        <button class="btn" type="button" @onclick="@(() => Nav.NavigateTo("/entries"))">Back to Entries</button>
    </div>
}
else
{
    <div class="card">
        <div class="meta">@_entry.DateIso</div>
        <div class="title">@_entry.Title</div>

        <div class="actions">
            <button class="btn" type="button" @onclick="Edit">Edit</button>
            <button class="btn danger" type="button" @onclick="DeleteAsync">Delete</button>
        </div>

        <div class="content">
            @((MarkupString)_html)
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _ready;
    private JournalEntry? _entry;
    private string _html = "";

    private static readonly MarkdownPipeline _md =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    protected override async Task OnInitializedAsync()
    {
        var user = await Auth.GetUserAsync();
        if (user is null)
        {
            Nav.NavigateTo("/signup", replace: true);
            return;
        }

        await LoadAsync();
        _ready = true;
    }

    private async Task LoadAsync()
    {
        try
        {
            // Your JournalService doesn’t have GetByIdAsync; simplest is scan list for now.
            // If you want, we can add GetByIdAsync to service as a clean next step.
            var list = await Journal.ListAsync((await Auth.GetUserAsync())!.Id);
            _entry = list.FirstOrDefault(e => e.Id == Id);

            if (_entry is not null)
                _html = Markdig.Markdown.ToHtml(_entry.ContentMarkdown ?? "", _md);
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load entry: {ex.Message}");
        }
    }

    private void Edit()
    {
        if (_entry is null) return;
        Nav.NavigateTo($"/today?date={_entry.DateIso}&edit=1");
    }

    private async Task DeleteAsync()
    {
        if (_entry is null) return;

        try
        {
            await Journal.DeleteAsync(_entry.Id);
            Toast.Success("Entry deleted.");
            Nav.NavigateTo("/entries", replace: true);
        }
        catch (Exception ex)
        {
            Toast.Error($"Delete failed: {ex.Message}");
        }
    }
}

<style>
    .entry-title {
        font-size: 44px;
        font-weight: 900;
        margin: 16px 0 10px;
        color: #e9eefc
    }

    .center {
