        align-items: center;
        justify-content: center;
        height: 45vh;
        color: #9fb0d2
    }

    .card {
        max-width: 980px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.10)
    }

    .meta {
        color: #9fb0d2;
        font-weight: 800;
        margin-bottom: 8px
    }

    .title {
        font-size: 30px;
        font-weight: 900;
        color: #e9eefc;
        margin-bottom: 10px
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-bottom: 12px
    }

    .btn {
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(0,0,0,0.18);
        color: #e9eefc
    }

        .btn.danger {
            border-color: rgba(255,80,80,0.35);
            color: #ffd1d1
        }

    .content {
        color: #c9d6f2
    }

    .panel {
        max-width: 680px;
        padding: 16px;
        border-radius: 18px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.10)
    }

    .panel-title {
        font-size: 18px;
        font-weight: 900;
        color: #e9eefc;
        margin-bottom: 10px
    }
</style>
