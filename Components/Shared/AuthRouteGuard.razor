@using ReflektJournal.Services.Interfaces
@inject IAuthService Auth
@inject NavigationManager Nav

@code {
    private static readonly HashSet<string> Allowlist = new(StringComparer.OrdinalIgnoreCase)
    {
        "/", "/login", "/signup"
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _ = EnforceAsync(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = EnforceAsync(e.Location);
    }

    private Task EnforceAsync(string absoluteUri)
    {
        var path = new Uri(absoluteUri).AbsolutePath;
        if (string.IsNullOrWhiteSpace(path)) path = "/";

        if (Allowlist.Contains(path))
        {
            if (Auth.IsUnlocked && (path.Equals("/login", StringComparison.OrdinalIgnoreCase) || path.Equals("/signup", StringComparison.OrdinalIgnoreCase)))
                Nav.NavigateTo("/today", replace: true);

            return Task.CompletedTask;
        }

        if (!Auth.IsUnlocked)
            Nav.NavigateTo("/login", replace: true);

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}